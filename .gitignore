# ==============================================================================
# KAYO - .gitignore
# Configured for GitHub (<100MB File Limit) and Render Production Deployment
# ==============================================================================

# --- Node & Frontend Dependencies ---
node_modules/
frontend/node_modules/
.npm/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Frontend Build Output ---
# (Render builds frontend at deploy time; dist is excluded from git)
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
.vite/
frontend/.vite/

# --- Python Bytecode & Runtime ---
__pycache__/
backend/**/__pycache__/
backend/engine/__pycache__/
backend/ml/__pycache__/
backend/models/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Virtual Environments ---
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# --- Environments & Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# --- IDEs & OS Files ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# --- Large Datasets & Raw Dumps (Strictly keeps repo < 100MB limit for GitHub) ---
# Raw heavy CSVs, packet captures, and parquet dumps
data/raw/
data/processed/
*.pcap
*.pcapng
*.csv
*.tsv
*.parquet
*.h5
*.hdf5
*.dump

# Keep critical model files and dataset manifest intact
!data/dataset_manifest.json
!data/models/
!data/models/**
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- Testing & Coverage Artifacts ---
.coverage
.coverage.*
.pytest_cache/
htmlcov/
.tox/
.nox/

# --- Temporary Files & Archives ---
tmp/
temp/
*.log
*.bak
*.tmp
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
